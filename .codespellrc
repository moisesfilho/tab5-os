# codespell: política única do projeto. Os diretórios gerados/vendidos ficam
# fora do escopo; a lista abaixo contém somente falsos positivos PT-BR, além
# dos identificadores `assertIn`/`assertin` e `dout` (campo BSP I2S) usados pelo
# projeto. Não adicionar palavras inglesas válidas indiscriminadamente.
[codespell]
skip = *build*,*managed_components*,*m5stack_tab5*
ignore-words-list = faze,fase,fases,vetor,caracteres,atual,erro,erros,controle,controles,nome,nomes,itens,oficial,ser,orientacao,rotacao,variante,datas,comando,comandos,sequencial,limite,cliente,utiliza,momento,componente,componentes,responde,seletor,acidental,foto,fotos,som,classe,classes,copie,conector,pares,nd,retangular,meu,caractere,descritor,leve,serie,cenario,cenarios,absorve,falso,ignora,assertin,excede,saem,conter,vai,envolve,eles,funcional,termine,adquire,dout
