---
# Checkers do clang-tidy usados no CI (lint estático).
# Set conservador p/ firmware embarcado: sem WarningsAsErrors para
# não bloquear o build em false positives do toolchain RISC-V.
Checks: >
  clang-diagnostic-*,
  bugprone-*,
  performance-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-named-parameter,
  -readability-function-cognitive-complexity,
  -readability-function-size,
  -readability-math-missing-parentheses,
  -readability-use-std-min-max,
  -readability-static-definition-in-anonymous-namespace,
  -readability-implicit-bool-conversion,
  -readability-braces-around-statements,
  -readability-else-after-return,
  -readability-uppercase-literal-suffix,
  -readability-isolate-declaration,
  -performance-enum-size,
  -performance-no-int-to-ptr,
  -bugprone-suspicious-enum-usage,
  -bugprone-casting-through-void,
  -clang-diagnostic-extern-c-compat,
  -clang-diagnostic-unknown-warning-option,
  -clang-analyzer-deadcode.DeadStores
WarningsAsErrors: ''
HeaderFilterRegex: 'components/(os|apps)/'
FormatStyle: none
