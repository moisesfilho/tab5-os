---
# Checkers do clang-tidy usados no CI (lint estático).
# Set conservador p/ firmware embarcado: sem WarningsAsErrors para
# não bloquear o build em false positives do toolchain RISC-V.
# Exclusões deliberadas: assignment-in-if é o padrão de retorno de erro do
# firmware; defined(X) mantém a intenção multi-target explícita.
Checks: >
  clang-diagnostic-*, bugprone-*, performance-*, readability-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-named-parameter,
  -readability-function-cognitive-complexity,
  -readability-function-size,
  -readability-math-missing-parentheses,
  -readability-use-std-min-max,
  -readability-static-definition-in-anonymous-namespace,
  -readability-implicit-bool-conversion,
  -readability-braces-around-statements,
  -readability-else-after-return,
  -bugprone-assignment-in-if-condition,
  -readability-use-concise-preprocessor-directives,
  -readability-uppercase-literal-suffix,
  -readability-isolate-declaration,
  -performance-enum-size,
  -performance-no-int-to-ptr,
  -bugprone-suspicious-enum-usage,
  -bugprone-casting-through-void,
  -clang-diagnostic-extern-c-compat,
  -clang-diagnostic-unknown-warning-option,
  -clang-diagnostic-unknown-pragmas,
  -clang-analyzer-deadcode.DeadStores,
  -clang-analyzer-unix.Stream*
WarningsAsErrors: ''
HeaderFilterRegex: 'components/(os|apps)/(?!.*minimp3).*'
FormatStyle: none
